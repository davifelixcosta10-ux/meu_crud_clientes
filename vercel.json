{
  "builds": [
    {
      "src": "main.py",
      "use": "@vercel/python"
    },
    {
      "src": "static/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/(app.js|style.css|.*\\.png|.*\\.jpg)",
      "dest": "/static/$1"
    },
    {
      "src": "/api/(.*)",
      "dest": "main.py"
    },
    {
      "src": "/clientes(.*)",
      "dest": "main.py"
    },
    {
      "src": "/(.*)",
      "dest": "/static/index.html"
    }
  ]
}